// Add inside `match /databases/{database}/documents { … }` of your Firestore rules.
// Pigmento cards: each user can only read, create and delete their own.
match /playgroundCards/{cardId} {
  allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
  allow create: if request.auth != null
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.html is string
    && request.resource.data.html.size() <= 8000
    && request.resource.data.keys().hasOnly(['userId', 'title', 'prompt', 'html', 'createdAt']);
  allow update: if false;
}
