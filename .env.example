# Server-only. Do not commit a real .env.

# Gemini key used by the assistant. Never prefix with VITE_.
API_KEY=

# Owner unlock. Visit /?access=<this value> once (16+ characters).
# The value is removed from the address bar and kept in this browser.
# If this is empty, CREATOR_BYPASS_SECRET is used (same name as MiniMe).
OWNER_ACCESS_CODE=

# Optional Firebase overrides. Defaults match the public web config.
# FIREBASE_WEB_API_KEY=
# FIREBASE_PROJECT_ID=chroma-forge

# Optional Stripe price ids for the credit packs.
# When empty, checkout uses the prices $9.99 and $39 a year directly.
# VITE_STRIPE_PRICE_CREDITS_600=
# VITE_STRIPE_PRICE_CREDITS_2400=
